# ==============================================================================
# AI COMMAND CENTER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and customize the values for your local environment:
#   cp .env.example .env
#
# NOTE: Never commit .env with sensitive tokens to version control.
# ==============================================================================

# Server Network Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development

# API Security
# 32-byte hexadecimal secret key for REST API and WebSocket authentication.
# If left empty, the server automatically generates and saves a secure token to .env on initial startup.
COMMAND_CENTER_API_KEY=

# ------------------------------------------------------------------------------
# Antigravity Workspace Paths (Optional Overrides)
# Defaults automatically resolve to standard Google Antigravity locations in ~/.gemini
# ------------------------------------------------------------------------------

# Windows Path Examples:
# ANTIGRAVITY_DIR=C:\Users\username\.gemini\antigravity
# KNOWLEDGE_DIR=C:\Users\username\.gemini\antigravity\knowledge\ai-director
# PRESENCE_DIR=C:\Users\username\.gemini\antigravity\presence
# BRAIN_DIR=C:\Users\username\.gemini\antigravity\brain
# AGY_CLI_PATH=C:\Users\username\AppData\Local\agy\bin\agy.exe

# Linux / macOS Path Examples:
# ANTIGRAVITY_DIR=/home/username/.gemini/antigravity
# KNOWLEDGE_DIR=/home/username/.gemini/antigravity/knowledge/ai-director
# PRESENCE_DIR=/home/username/.gemini/antigravity/presence
# BRAIN_DIR=/home/username/.gemini/antigravity/brain
# AGY_CLI_PATH=/usr/local/bin/agy

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# SQLite database file path (defaults to ./command_center.sqlite in project root)
# DB_PATH=command_center.sqlite
