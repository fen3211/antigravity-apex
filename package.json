{
  "name": "ai-command-center",
  "version": "1.0.0",
  "description": "Premium Multi-Agent Management Dashboard for Antigravity AI Development Director",
  "main": "server/dist/index.js",
  "type": "module",
  "scripts": {
    "server": "tsx server/src/index.ts",
    "server:build": "tsc -p server/tsconfig.json",
    "client": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "test": "tsx tests/api.test.ts && tsx tests/ingestion.test.ts && tsx tests/analytics.test.ts && tsx tests/websocket-resilience.test.ts && tsx tests/process-supervisor.test.ts && tsx tests/legal-compliance.test.ts && tsx tests/backend-audit.test.ts && tsx tests/intelligent-argon-escalation.test.ts",
    "test:escalation": "tsx tests/intelligent-argon-escalation.test.ts",
    "test:ingestion": "tsx tests/ingestion.test.ts",
    "test:analytics": "tsx tests/analytics.test.ts",
    "test:ws": "tsx tests/websocket-resilience.test.ts",
    "test:supervisor": "tsx tests/process-supervisor.test.ts",
    "test:audit": "tsx tests/backend-audit.test.ts",
    "start": "node server/dist/index.js",
    "test:legal": "tsx tests/legal-compliance.test.ts",
    "doctor": "node scripts/doctor.js"
  },
  "keywords": [
    "antigravity",
    "ai-director",
    "multi-agent",
    "dashboard",
    "command-center"
  ],
  "author": "AI Development Director",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
